[global]
# Regex to match webirc hosts using ident containing hex encoded client ip (<hex>@<host>)
webirc_hosts=.*(\.mibbit\.com|\.kiwiirc\.com)

[bl:dnsbl.dronebl.org]
ban_unknown=false
default_ban_message=Your host is listed in the DroneBL (%reason%). https://dronebl.org/lookup?ip=%ip% for info.
reply:2=Sample
reply:3=IRC Drone
reply:5=Bottler
reply:6=Unknown spambot or drone
reply:7=DDOS Drone
reply:8=SOCKS Proxy
reply:9=HTTP Proxy
reply:10=ProxyChain
reply:11=Web Page Proxy
reply:12=Open DNS Resolver
reply:13=Brute force attackers
reply:14=Open Wingate Proxy
reply:15=Compromised router / gateway
reply:16=Autorooting worms
reply:17=Auto determined botnet IPs
reply:18=DNS/MX type hostname on IRC
reply:19=Abused VPN Service
reply:255=Unknown

[bl:rbl.efnetrbl.org]
ban_unknown=false
default_ban_message=Your host is listed in EFNetRBL (%reason%). https://rbl.efnetrbl.org/?i=%ip% for info.
reply:1=Open Proxy
reply:2=spamtrap666
reply:3=spamtrap50
reply:4=TOR
reply:5=Drones / Flooding

[bl:torexit.dan.me.uk]
ban_unknown=false
default_ban_message=Your host is a TOR exit node (%reason%). https://www.dan.me.uk/dnsbl for info.
reply:100=TOR Exit Node
